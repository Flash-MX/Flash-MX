#   Config file for heater API
REQUIRES physics/HeatAD/HeatADMain
REQUIRES physics/sourceTerms/Heater/localAPI

D useHeater Should the Heater unit be used?
PARAMETER useHeater BOOLEAN TRUE

PPDEFINE HEATER_MAIN

USESETUPVARS HeaterFluxBC
IF HeaterFluxBC
    PPDEFINE HEATER_MAIN_FLUXBC
ENDIF

D htr_nucSeedRadius for re-nucleation
PARAMETER htr_nucSeedRadius  REAL     0.1

D htr_numHeaters Total number of heaters
PARAMETER htr_numHeaters     INTEGER  1

D htr_heaterName Prefix for HDF5 htr file
PARAMETER htr_heaterName     STRING  "flash"

D htr_showInfo Should heater info be displayed on console?
PARAMETER htr_showInfo BOOLEAN FALSE

D htr_annQueries Number of queries for approximate nearest neighbor search
PARAMETER htr_annQueries INTEGER 3

D htr_lumpedFlg Lumped-capacitance (isothermal) heater: the heater wallTemp evolves each step from
D & the balance between the imposed heatFlux and the flux the fluid removes (Heater_updateLumped).
D & Forces heatFluxFlg = varTempFlg = false (Dirichlet wall at the uniform wallTemp).
PARAMETER htr_lumpedFlg BOOLEAN FALSE

D htr_lumpedCapacity heat capacity per unit area of the lumped heater, nondimensional:
D & (rho c delta)_heater lc / (k_l tc). Physical copper heaters are ~1e4; smaller values relax faster.
PARAMETER htr_lumpedCapacity REAL 100.0

D htr_lumpedWallTemp if > -1e29, replaces the heater file's wallTemp at startup and the value
D & stored in a checkpoint on restart
PARAMETER htr_lumpedWallTemp REAL -1.0e30

PPDEFINE HTR_MAX_NUMSITES 150
